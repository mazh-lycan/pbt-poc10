# Chip private keys for Season1byMazh.
# CHIP_KEY_1 pairs with token 1, CHIP_KEY_2 with token 2, and so on.
# Generate a fresh set with: node scripts/keygenerator.js 10
# Copy the addresses it prints into ignition/modules/Season1byMazh.ts,
# then run: node scripts/verify-chips.js
#
# Copy this file to .env and fill the values there. .env is gitignored.

CHIP_KEY_1=
CHIP_KEY_2=
CHIP_KEY_3=
CHIP_KEY_4=
CHIP_KEY_5=
CHIP_KEY_6=
CHIP_KEY_7=
CHIP_KEY_8=
CHIP_KEY_9=
CHIP_KEY_10=
